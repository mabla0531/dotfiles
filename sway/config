set $meta Mod4

exec mako
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP SWAYSOCK DISPLAY
exec hash dbus-update-activation-environment 2>/dev/null && dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway SWAYSOCK DISPLAY
exec swaybg -i ~/wallpapers/2-coffee-beans.jpg

floating_modifier $meta

bindsym $meta+T exec ghostty
bindsym $meta+B exec helium-browser
bindsym $meta+Space exec wmenu-run -f "FiraCode Nerd Font Mono 16"
bindsym $meta+Escape exec ~/.config/scripts/swaylock.sh
bindsym $meta+Control+Escape exec wleave -l ~/.config/wleave/config.json

bindsym $meta+Shift+S exec hyprshot -m region -z --clipboard-only

bindsym $meta+Q kill
bindsym $meta+Return fullscreen toggle
bindsym $meta+F floating toggle

bindsym $meta+H focus left
bindsym $meta+J focus down
bindsym $meta+K focus up
bindsym $meta+L focus right

bindsym $meta+Left focus left
bindsym $meta+Down focus down
bindsym $meta+Up focus up
bindsym $meta+Right focus right

bindsym $meta+Shift+H move left
bindsym $meta+Shift+J move down
bindsym $meta+Shift+K move up
bindsym $meta+Shift+L move right

bindsym $meta+Shift+Left move left
bindsym $meta+Shift+Down move down
bindsym $meta+Shift+Up move up
bindsym $meta+Shift+Right move right

bindsym $meta+1 workspace number 1
bindsym $meta+2 workspace number 2
bindsym $meta+3 workspace number 3
bindsym $meta+4 workspace number 4
bindsym $meta+5 workspace number 5
bindsym $meta+6 workspace number 6
bindsym $meta+7 workspace number 7
bindsym $meta+8 workspace number 8
bindsym $meta+9 workspace number 9
bindsym $meta+0 workspace number 10

bindsym $meta+Shift+1 move container to workspace number 1, workspace number 1
bindsym $meta+Shift+2 move container to workspace number 2, workspace number 2
bindsym $meta+Shift+3 move container to workspace number 3, workspace number 3
bindsym $meta+Shift+4 move container to workspace number 4, workspace number 4
bindsym $meta+Shift+5 move container to workspace number 5, workspace number 5
bindsym $meta+Shift+6 move container to workspace number 6, workspace number 6
bindsym $meta+Shift+7 move container to workspace number 7, workspace number 7
bindsym $meta+Shift+8 move container to workspace number 8, workspace number 8
bindsym $meta+Shift+9 move container to workspace number 9, workspace number 9
bindsym $meta+Shift+0 move container to workspace number 10, workspace number 10

workspace 1 output HDMI-A-1
workspace 2 output HDMI-A-1
workspace 3 output HDMI-A-1
workspace 4 output HDMI-A-1
workspace 5 output HDMI-A-1

output HDMI-A-1 res 2560x1440 pos 0 0
output DP-1 res 2560x1440 pos 2560 0

bar {
  status_command i3status -c ~/.config/i3status/i3status.conf
  position top
  font pango:FiraCode Nerd Font Mono 14
}
