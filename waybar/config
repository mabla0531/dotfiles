{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 4,

  "modules-left": [
    "hyprland/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "tray"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "format-active": "[{name}]",
    "format-urgent": "!{name}!"
  },

  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A, %B %d, %Y}"
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "",
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "network": {
    "format-wifi": " ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰖪 ",
    "tooltip-format": "{ifname} {ipaddr}"
  },

  "cpu": {
    "interval": 5,
    "format": " {usage:>2}%"
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {used:0.1f}G"
  },

  "tray": {
    "spacing": 6
  }
}
